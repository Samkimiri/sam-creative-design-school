# Copy to .env.local for local development

# MongoDB (local) — on Vercel use SCDS_DB_MONGODB_URI from the MongoDB integration
MONGODB_URI=

# Supabase database backend (preferred for production)
# Run supabase/schema.sql in your Supabase SQL editor, then add these server-only values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional aliases if you want to keep SCDS database variables grouped:
SCDS_DB_SUPABASE_URL=
SCDS_DB_SUPABASE_SERVICE_ROLE_KEY=

# Session signing (required in production on Vercel)
JWT_SECRET=

# Admin API password
ADMIN_PASSWORD=
# Optional alias supported by the admin API
SCDS_ADMIN_PASSWORD=

# Optional backend timeout override in milliseconds
SCDS_DB_TIMEOUT_MS=5000

# ─── Safaricom Daraja M-Pesa (Lipa na M-Pesa Online / STK Push) ───
# Register at https://developer.safaricom.co.ke and create an app.
# Sandbox test phone: 254708374149 | Sandbox shortcode: 174379

# sandbox | production
MPESA_ENV=sandbox

# From Daraja portal → your app → Consumer Key & Secret
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# PayBill number or Till number (sandbox: 174379)
MPESA_SHORTCODE=

# Optional alias for Buy Goods Till integrations.
# If this is set and MPESA_SHORTCODE is empty, the app uses Buy Goods mode.
MPESA_TILL_NUMBER=

# Lipa na M-Pesa Online passkey (Daraja portal → STK Push / Initiate)
MPESA_PASSKEY=

# Public HTTPS callback — must match URL registered in Daraja.
# Add ?secret=your_secret when MPESA_CALLBACK_SECRET is set.
# Production example: https://sam-creative-design-school.vercel.app/api/mpesa/callback
MPESA_CALLBACK_URL=
MPESA_CALLBACK_SECRET=

# paybill | buygoods | till
MPESA_PAYMENT_MODE=

# CustomerPayBillOnline (PayBill) or CustomerBuyGoodsOnline (Buy Goods Till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# For Till: set to your Till number. For PayBill: same as MPESA_SHORTCODE
MPESA_PARTY_B=

# Display name on enrollment receipts
MPESA_ACCOUNT_NAME=Samuel Kimiri

# Flutterwave Standard Checkout
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_CURRENCY=KES
# Production example: https://sam-creative-design-school.vercel.app/api/flutterwave/callback
FLUTTERWAVE_REDIRECT_URL=
# Add this same URL as the Flutterwave webhook URL:
# https://sam-creative-design-school.vercel.app/api/flutterwave/callback
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_PAYMENT_OPTIONS=card,mobilemoney,banktransfer
FLUTTERWAVE_TITLE=Sam Creative Design School
FLUTTERWAVE_LOGO_URL=https://sam-creative-design-school.vercel.app/images/scds-monogram.svg
# Set to true only if Flutterwave rejects payload_hash for your account.
FLUTTERWAVE_DISABLE_PAYLOAD_HASH=false

# Vercel KV (optional)
KV_REST_API_URL=
KV_REST_API_TOKEN=
